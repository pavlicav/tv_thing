{
  "openapi": "3.1.0",
  "info": {
    "title": "TV Thing core integration API",
    "version": "1.4.0",
    "description": "Core control contract. API.md defines ownership, retry, addressing, and trusted-LAN rules. Additional discovery and diagnostic endpoints are listed by GET /api/v1. 1.1.0 adds the roku lane: Roku sources, asynchronous Roku tunes (202 with an operation), the Roku remote, the still-playing check, and Roku recordings. 1.2.0 adds TV Thing channel numbers: tv_number, tv_name and tv_section on catalog items and guide channels, the lineup in GET /sources, and GET /lineup. 1.3.0 adds YouTube TV's listings to the guide: rows keyed youtube-tv/NAME with kind roku, every row's key and kind, the youtube_tv summary, and Roku guide recordings. 1.4.0 adds the station's slide channels: lineup.slides in GET /sources, kind slides in GET /lineup, and GET /sports-guide, the Sports Guide's listings (channel 60); each slide channel's stream_path, its live HLS made on demand (/stream/sports-guide/index.m3u8), and slides in GET /status."
  },
  "servers": [
    {
      "url": "./",
      "description": "Served at /api/v1/openapi.json; resolves to the current API base, including /tv/."
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "summary": "Lane status; poll the requested lane and generation",
        "responses": {
          "200": {
            "description": "Success",
