    "/sources/{roku_source}": {
      "get": {
        "summary": "Feeds of one Roku source; games are listed for ?date=YYYY-MM-DD.",
        "parameters": [
          {
            "name": "roku_source",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "youtube-tv",
                "mlb",
                "thursday-night-football",
                "sunday-ticket",
                "roku-manual"
              ]
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "source and items[] ({id, name, ...})",
            "content": {
              "application/json": {
                "schema": {
