    "/lineup": {
      "get": {
        "summary": "Every channel with its TV Thing number, in number order",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "YYYY-MM-DD: the day whose games are listed",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "channels",
                    "sections"
                  ],
                  "properties": {
                    "date": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "sections": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "channels": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "tv_number": {
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "tv_name": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "tv_section": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "kind": {
                            "enum": [
                              "vizelvision",
                              "slides",
                              "internet",
                              "digital",
                              "roku"
                            ]
                          },
                          "source_id": {
                            "type": "string"
                          },
                          "channel_id": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "lineup_error": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sports-guide": {
      "get": {
        "summary": "Today's watchable games by sport: the Sports Guide's listings (channel 60)",
        "description": "A game is listed when a national broadcaster in the lineup carries it (by that channel's number; a network on its DC antenna station) or a Roku game source does (by its Live Sports number). Games already over are left out; before 06:00 Eastern, the night's games still being played stay in. Cached for a minute.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "date",
                    "available",
                    "sports",
                    "errors"
                  ],
                  "properties": {
                    "date": {
                      "type": "string",
                      "description": "today, Eastern (YYYY-MM-DD)"
                    },
                    "generated_at": {
                      "type": "integer"
                    },
                    "available": {
                      "type": "boolean"
                    },
                    "games": {
                      "type": "integer"
                    },
                    "channel": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "description": "the Sports Guide's lineup entry"
                    },
                    "sports": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "sport": {
                            "type": "string"
                          },
                          "games": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "sport",
                                "league",
                                "tag",
                                "start",
                                "live",
                                "title",
                                "network",
                                "tv_number",
                                "via"
                              ],
                              "properties": {
                                "sport": {
                                  "type": "string"
                                },
                                "league": {
                                  "type": "string",
                                  "description": "nfl, ncaaf, mlb, nba, wnba, ncaam, ncaaw, nhl, epl, ucl, mls or nwsl"
                                },
                                "tag": {
                                  "type": "string",
                                  "description": "the league as the slides print it (NFL, NCAA)"
                                },
                                "start": {
                                  "type": [
                                    "integer",
                                    "null"
                                  ],
                                  "description": "Unix seconds"
                                },
                                "start_time": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "time_tbd": {
                                  "type": "boolean"
                                },
                                "live": {
                                  "type": "boolean",
                                  "description": "being played now"
                                },
                                "title": {
                                  "type": "string",
                                  "description": "Away at Home"
                                },
                                "away": {
                                  "type": "string"
                                },
                                "home": {
                                  "type": "string"
                                },
                                "network": {
                                  "type": "string",
                                  "description": "the broadcaster (TBS), or the service on a Live Sports number (Sunday Ticket)"
                                },
                                "tv_number": {
                                  "type": "integer",
                                  "description": "the TV Thing channel to watch it on"
                                },
                                "via": {
                                  "type": "string",
                                  "description": "channel when a lineup channel carries it, else the game source id"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "the schedules that did not answer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
