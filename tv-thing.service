[Unit]
Description=TV Thing ATSC + analog streaming server
After=network.target

[Service]
Type=simple
User=vivian
WorkingDirectory=/home/vivian/tv_thing
# Bind by interface, not by a literal address: the previous pinned
# 192.168.86.230 was the old Wi-Fi address and stopped being assignable when
# the host moved to Ethernet, so the service could not start. The server
# resolves this at boot and falls back to any other LAN address before the
# wildcard (another service already holds :8080 on tailscale0).
# 127.0.0.1 is always bound as well, which is what Apache proxies /tv/ to.
Environment=TV_THING_BIND=iface:enx9405bb192913
# 90 C, under the card's 97 C slowdown; vizelVision's NVENC master alone holds ~86 C.
Environment=TV_THING_MAX_GPU_TEMP_C=90
Environment=TV_THING_VIDEO_ENCODER=cpu
# Recordings live on the 4 TB data drive, not the boot SSD; MiniDLNA indexes
# the folder as its own media_dir (see deploy notes in API.md).
Environment="TV_THING_RECORDINGS_DIR=/mnt/sda1/media/TV Recordings"
ExecStart=/home/vivian/miniconda3/bin/python3 /home/vivian/tv_thing/server.py
# Restart on a clean exit too. The server exits 0 when it is signalled, so
# on-failure left a SIGTERM/SIGINT'd service stopped until someone noticed.
Restart=always
RestartSec=5
TimeoutStopSec=5
# The digital and analog lanes each run their own H.264 encoder, so the
# quota and memory ceiling cover two concurrent transcodes.
#
# Since 2026-10-06 the unit also carries the source Roku (roku_lane.py): the
# HD PVR capture (a stream copy), the screen-recognition decoder while the
# Roku navigates, OCR, and the Roku VCR's copy. That work moved here from
# vizelVision's units; it was not added to the house. The owner raised the
# memory and task ceilings for it, and an OOM kill of one child (the 0.4 GB
# MPEG-2 frames of 2026-09) must no longer take the whole unit down: each
# child has its own supervisor that restarts it.
CPUQuota=400%
MemoryMax=1800M
TasksMax=192
OOMPolicy=continue
# The 16 MB soft cap kills a runaway HLS segment early. Only the VCR's
# recorder processes raise their own soft limit, to TV_THING_RECORD_MAX_GB
# (16 GB); everything else keeps the 16 MB cap.
LimitFSIZE=16M:16G

[Install]
WantedBy=multi-user.target
